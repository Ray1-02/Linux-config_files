{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "shell",
    "kernel",
    "wifi",
    "packages",
    "locale",
    "localip",
    "separator",
    "wm",
    "cursor",
    "terminal",
    "terminalfont",
    "separator",
    "theme",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "display",
    "battery",
    "poweradapter",
    "separator",
    "uptime",
    {
	    "type":"command",
	    "key":"OS Age ",
	    "text":"birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression/86400)); echo $days_difference days"
    },
    {
	    "type": "datetime",
	    "key": "DateTime"
    },
    "seperator",
    "colors"
  ]
}
