{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display":{
	  "color":{
		  "keys":"blue",
		  "title":"italic_red"
	  },
	  "percent":{
		  "type":9,
		  "color":{
			  "green":"italic_default",
			  "yellow":"italic_light_yellow",
			  "red":"italic_light_red"
		  }
	  }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "shell",
    "kernel",
    "wifi",
    "packages",
    "locale",
    "localip",
    "separator",
    "wm",
    "cursor",
    "terminal",
    "terminalfont",
    "separator",
    "theme",
    "cpu",
    "gpu",
    {
	    "type":"memory",
	    "key":"Memory",
	    "percent":{
		    "type":9,
		    "green":30,
		    "yellow":60
	  }
    },
    {
	    "type":"disk",
	    "key":"Disk",
	    "percent":{
		    "type":9,
		    "green":40,
		    "yellow":80
	  }
    },
    "display",
    "battery",
    "poweradapter",
    "separator",
    "uptime",
    {
	    "type":"command",
	    "key":"OS Age ",
	    "text":"birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression/86400)); echo $days_difference days"
    },
    {
	    "type": "datetime",
	    "key": "DateTime"
    },
    "separator",
    "wallpaper"
  ]
}
